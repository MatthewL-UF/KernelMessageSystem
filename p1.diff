 EXPORT_SYMBOL(fs_overflowuid);
 EXPORT_SYMBOL(fs_overflowgid);
 
+/*P1 Set and Get*/
+
+struct message_link{
+	char txt[1025];
+	uid_t recipient;
+	uid_t sender;
+
+	struct list_head list; // Chosen Data Structure.
+	// Ability to move up to first in to take out when get
+	// makes doubly linked list useful here.
+
+};
+// As our lizard overlords command
+// Doubly Linked List that will hold everything.
+static LIST_HEAD(SkySkink);
+
+SYSCALL_DEFINE2(send_message_call, char __user *, msg, uid_t, recipient_user){
+	//Make the struct
+	struct message_link *nmsg;
+	long result;
+	//Make space for the struct
+	nmsg = kmalloc(sizeof(*nmsg), GFP_KERNEL);
+	if(nmsg==NULL){
+		//If there is no memory, don't continue, or everything will probably fail and crash.
+		return -1;
+	}
+	//Put message in the new var
+	result = copy_from_user(nmsg->txt, msg, 1025);
+	if (result != 0){
+		//If we get anything other than 0, we failed.
+		//Free the space it was going to use.
+		kfree(nmsg);
+		//Spit out error.
+		return -1;
+	}
+
+	// Sender and Receiver now.
+	nmsg->recipient = recipient_user;
+	nmsg->sender = __kuid_val(current_uid());
+
+	list_add_tail(&nmsg->list, &SkySkink);
+
+	return 0;
+}
+SYSCALL_DEFINE2(get_message_call, char __user *, msg, uid_t __user *, sending_user){
+	struct message_link *pos;
+	uid_t recipientCheck = __kuid_val(current_uid());
+
+	list_for_each_entry(pos, &SkySkink, list){
+		//First instance closest to head with the right recipient id
+		if (pos->recipient == recipientCheck){
+			//Copy message
+			long result = copy_to_user(msg, pos->txt, 1025);
+
+			//Make sure didn't explode
+			if(result!=0){
+				//If it did, stop and return error.
+				return -1;
+			}
+
+			//Get sender
+			result = copy_to_user(sending_user, &pos->sender, sizeof(pos->sender));
+
+			//Make sure didn't explode
+			if(result!=0){
+				return -1;
+			}
+
+			//Delete message struct and free space.
+			list_del(&pos->list);
+			kfree(pos);
+
+			//Return Success
+			return 0;
+		}
+	}
+
+	//Nothing Found.
+	return 1;
+}
+
